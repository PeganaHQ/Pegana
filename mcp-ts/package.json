    "@x402/svm": "^2.28.0",
    "hono": "^4.13.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "latest",
    "@types/pg": "^8.20.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
