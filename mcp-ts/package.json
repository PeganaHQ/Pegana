{
  "name": "pegana-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "description": "MCP server exposing Pegana's peg-risk oracle for Solana: real-time peg state, history, and alerts for the tracked asset list. Every tool is free; no API key, no payment.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "stablecoin",
    "lst",
    "liquid-staking",
    "peg",
    "depeg",
    "oracle",
    "defi",
    "x402",
    "usdc"
  ],
  "homepage": "https://pegana.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeganaHQ/ReplayCLI.git",
    "directory": "mcp-ts"
  },
  "bugs": {
    "url": "https://github.com/PeganaHQ/ReplayCLI/issues"
  },
  "license": "MIT",
  "author": "Pegana <hello@pegana.xyz> (https://pegana.xyz)",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --dir test/integration",
    "test:devnet": "vitest run --dir test/integration -t devnet",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
