# Redis (same instance as engine-rs + dispatcher-rs use)
# prod-local docker: redis://localhost:6381
REDIS_URL=redis://localhost:6379

# Postgres (same DB)
# prod-local docker: postgres://pegana:pegana@localhost:5434/pegana
DATABASE_URL=postgres://pegana:pegana@localhost:5432/pegana

# Every MCP tool is free — there is no payment receiver and no facilitator
# credentials to configure. Set this only to point the (currently unused)
# resource server at a different facilitator.
# X402_FACILITATOR_URL=https://x402.org/facilitator

# Solana network for the x402 scheme (CAIP-2 format), used only to build the
# resource server that carries the Bazaar discovery extension.
# devnet:  solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# mainnet: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp   # mainnet-beta genesis hash

# Server
HTTP_PORT=8090
LOG_LEVEL=info

# Optional Sentry (E2)
SENTRY_DSN=
