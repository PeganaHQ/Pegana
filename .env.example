# Database — dev compose uses 5433/6380 on host to avoid clash with system services.
# In production (docker-compose.yml), services share internal network so use 5432/6379.
DATABASE_URL=postgres://pegana:pegana@localhost:5433/pegana
# Local dev with no Redis password set — production sets one via REDIS_PASSWORD
# below and the compose file overrides REDIS_URL to include credentials.
REDIS_URL=redis://localhost:6380

# Redis bootstrap — required in production (compose refuses to start without it).
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# Postgres bootstrap — consumed by the timescaledb container in compose. The
# compose file refuses to start if POSTGRES_PASSWORD is unset (`${VAR:?required}`),
# so this MUST be populated before `docker compose up`. POSTGRES_USER /
# POSTGRES_DB fall back to "pegana" when empty.
POSTGRES_USER=pegana
POSTGRES_DB=pegana
POSTGRES_PASSWORD= # REQUIRED in prod — generate with: openssl rand -hex 24

# Logging
RUST_LOG=info,sqlx=warn

# Sentry — leave SENTRY_DSN empty in dev. When set, all services initialize
# Sentry with `service` tag = indexer/engine/api/dispatcher so per-service
# filtering works out of the box.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# Sentry — web (Q-005). Browser SDK needs the DSN baked into the bundle,
# so the var has to be NEXT_PUBLIC_*. Use the SAME Sentry project as the
# Rust services (reference_sentry.md `pegana-prod`) — `service` tag will
# read `web` automatically.
NEXT_PUBLIC_SENTRY_DSN=
# Build-only — Vercel project env, NEVER commit. Used by withSentryConfig
# to upload sourcemaps. Without it the build still succeeds, just no
# symbolication.
SENTRY_ORG=
SENTRY_PROJECT=pegana-prod
SENTRY_AUTH_TOKEN=

# External APIs (all free in v1 Lean)
SANCTUM_API_URL=https://extra-api.sanctum.so
# Keyed host. The keyless lite-api is being deprecated/throttled by Jupiter —
# free key from https://developers.jup.ag (Create API key), sent as x-api-key.
JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=
# Concurrent Jupiter quotes per tick. 1 is the keyless ceiling (0.5 RPS budget);
# with a key, 4–8 is safe and recovers staleness faster.
JUPITER_MAX_CONCURRENT=4
# Max age (s) accepted from cached Pyth readings before they're refused for
# FX-cross intrinsic derivation (e.g. BRZ via USD/BRL).
PYTH_STALENESS_SECS=30
# Engine: max age (s) for Pyth prints read from on-chain push-oracle accounts
# (the only Pyth path). They step at the push-feed heartbeat, so the 30s
# window above would flap them. Default 120.
# PYTH_ONCHAIN_STALENESS_SECS=120
# Pyth: the indexer reads Pyth's on-chain push-oracle accounts over
# SOLANA_RPC_URL (post-upgrade v2 program plus the legacy one, freshest print
# wins). No Hermes URL or API key is used. Optional knobs:
# PYTH_ONCHAIN_POLL_MS (12000), PYTH_ONCHAIN_MAX_AGE_SECS (604800).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_FALLBACK=https://solana-rpc.publicnode.com

# Tuning
ASSETS_FILE=./assets.toml
# Jupiter round-robin tick. 2500ms × concurrency=1 = 0.4 RPS sustained — under
# the 0.5 RPS keyless budget with safety margin. Drop to 500-1000 ms when
# JUPITER_API_KEY is set.
POLL_TICK_MS=2500
SANCTUM_POLL_MS=15000
HYLO_POLL_MS=30000
# Free intrinsic sources (USDY/sUSDe via Ethereum eth_call, JLP via the Jupiter
# Perpetuals pool, EURC via a Kraken + Coinbase FX median). ETH_RPC_URLS is a
# comma-separated list; empty uses keyless public RPCs (publicnode, 1rpc,
# drpc). A NAV publishes only when at least 2 RPCs agree, so list 2 or more.
# ETH_RPC_URLS=
# EVM_NAV_POLL_MS=60000
# JUPITER_PERPS_POLL_MS=15000
# FX_HTTP_POLL_MS=60000

# Engine
EWMA_ALPHA=0.3

# API
API_BIND=0.0.0.0:8080
API_RATE_LIMIT_PER_MIN=60
# Shared secret (>= 32 chars) the web app's SERVER sends in x-pegana-ssr-token
# so SSR / route-handler / OG fetches from Vercel's shared egress get their own
# budget instead of the public 60/min per-IP one. Set the SAME value as
# PEGANA_WEB_SSR_TOKEN in the Vercel project (server-only, never NEXT_PUBLIC_).
# Empty = no bypass. Generate with: openssl rand -hex 32
PEGANA_WEB_SSR_TOKEN=
PEGANA_WEB_SSR_RATE_LIMIT_PER_MIN=3000
# Comma-separated extra origins to add to the CORS allowlist on top of the
# baked-in `pegana.xyz`, `www.pegana.xyz`, `localhost:3000`. Use for Vercel
# preview deploys, ngrok tunnels, etc. Empty (or unset) = only the baked-in
# origins. Examples:
#   CORS_EXTRA_ORIGINS=https://pegana-git-preview.vercel.app
#   CORS_EXTRA_ORIGINS=https://preview-1.example.com,https://preview-2.example.com
CORS_EXTRA_ORIGINS=

# Launch mode (D7: dogfooding 2 weeks privately)
# FEATURE_PUBLIC_ALERTS gates the public read surface: when false, the api-rs
# /v1/audit index + .csv + RSS/Atom feeds return empty (calibration stays quiet);
# /v1/audit/{id} detail + /onchain stay public. See ADR-0020.
FEATURE_PUBLIC_ALERTS=false

# Alertmanager delivery channels (infra paging for ops/alerts/pegana.yml).
# Set Telegram, Discord, or both: every configured channel gets every alert.
# With neither set, alertmanager still starts but delivers NOTHING (null
# receiver, WARN in its log). The config is rendered at container start by
# ops/alertmanager/render-config.sh; recreate alertmanager after a change:
#   ./scripts/deploy.sh --config-only --services alertmanager
#
# Telegram: the bot token (from @BotFather) and the chat id it posts to. The
# chat id falls back to DOGFOOD_TELEGRAM_CHAT_ID when unset. The token reaches
# the container as a file (compose `configs:`), never as env.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=
# Discord: an https incoming webhook URL (Server Settings → Integrations →
# Webhooks → New Webhook → Copy URL). Same file mechanism as the token.
ALERTMANAGER_DISCORD_WEBHOOK_URL=

# Host directory where scripts/pg-backup.sh writes its textfile metrics; the
# node-exporter service mounts it read-only. Defaults to ${HOME}/.pegana-metrics
# of whoever runs `docker compose`. Pin it in prod so a compose run as another
# user (e.g. root) mounts the same directory.
# PEGANA_METRICS_DIR=/home/deploy/.pegana-metrics

# ─── v2 webhook channel ──────────────────────────────────────────────
# Ed25519 signing key — base64-encoded 32 bytes. The dispatcher signs
# every webhook payload with this private key; the corresponding public
# key is published at https://pegana.xyz/developers#webhook so receivers
# can verify.
#
# Generate a fresh keypair with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Then derive the public key:
#   python3 - <<'PY'
#   import base64, sys
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   priv = Ed25519PrivateKey.from_private_bytes(base64.b64decode("<PRIVATE_HERE>"))
#   print(base64.b64encode(priv.public_key().public_bytes_raw()).decode())
#   PY
#
# Rotation invalidates any in-flight signatures still being verified
# by stale receivers — coordinate with subscribers if you rotate post-launch.
PEGANA_WEBHOOK_SIGNING_KEY=

# ─── v2 MCP server (mcp.pegana.xyz) ─────────────────────────────────
# Every MCP tool is free: no payment receiver, no facilitator credentials.
# Solana network for the x402 scheme (CAIP-2 format), used only to build the
# resource server that carries the Bazaar discovery extension.
#   devnet:  solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
#   mainnet: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
SOLANA_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# Override only to point the (currently unused) resource server elsewhere.
# X402_FACILITATOR_URL=https://x402.org/facilitator

# ─── Observability / ops (audit F-32) ───────────────────────────────
# Grafana admin password. REQUIRED — `docker compose up` hard-fails without it
# (docker-compose.yml uses ${GRAFANA_ADMIN_PASSWORD:?required}). Gen: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=
# tokens.xyz sources — OPTIONAL; BOTH idle silently when unset (one key, two
# sources). Provision at https://app.tokens.xyz
#   1. `tokens_xyz`      — 60s batch liquidity poll (market-snapshots).
#   2. `tokens_xyz_risk` — slow holders/volume/market-cap poll (risk-details),
#                          89% asset coverage vs 37% for market-snapshots.
TOKENS_XYZ_API_KEY=
# Cadence of the market-context poll. Default 30 min. Keep this conservative:
# it shares the key with the 60s liquidity poll that is already in production,
# and one full pass is ~69 sequential calls (~30s wall time).
TOKENS_XYZ_RISK_POLL_MS=
# Birdeye market-data / liquidity — OPTIONAL; used for the beta→calibrated
# promotion liquidity gate (token_overview depth check, floor $25k / ADR-0026) and
# the depth-gate (Sub-B). 60 rpm total. Provision at https://docs.birdeye.so
BIRDEYE_API_KEY=

# Optional pepper for hashing waitlist emails in logs (audit F-04). Unset = unsalted.
# Gen: openssl rand -hex 16

# ── V2 in-hash gates (opt-in, ship DISABLED; see the private V2 launch runbook §C) ──
# Intrinsic-liveness gate (ADR-0038): force UNKNOWN on a frozen backing. Unset =
# the engine never reads the signal, verdicts + receipts byte-identical. ENABLE only
# AFTER calibrating against prod (see the runbook). Rollback = unset (no rebuild).
INTRINSIC_LIVENESS_GATE=
# Freshness bound (secs) for a liveness row; older → ignored (fail-open). Default 3600.
INTRINSIC_LIVENESS_FRESHNESS_SECS=
# Depth gate (ADR-0034): cap confidence on a thin market. Floor in USD; 0/unset = disabled.
DEPTH_GATE_FLOOR_USD=
DEPTH_GATE_FRESHNESS_SECS=
# NOTE: the Pyth confidence gate (ADR-0032, 500 bps) is a COMPILE-TIME const
# (methodology/thresholds.rs), NOT an env — it goes live unconditionally at the
# engine recreate. Calibrate against prod BEFORE that step.
