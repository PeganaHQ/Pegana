# pegana-protocol-indexer (Sub-C loop-intelligence indexer)

# Shared TimescaleDB + (optional) Redis — in prod these are the in-network
# hostnames set by docker-compose; locally point at the prod-local stack.
DATABASE_URL=postgres://pegana:pegana@localhost:5434/pegana

# HTTP server (health + Prometheus /metrics). 8091 is unused by the other
# services (api 8080, mcp-ts 8090, bot 3000).
HTTP_PORT=8091
LOG_LEVEL=info

# Solana RPC — primary + fallback (same contract as crates/indexer-rs).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_FALLBACK=https://solana-rpc.publicnode.com

# Jupiter quote API (for the slippage curve reused by the cascade model).
JUPITER_API_URL=https://lite-api.jup.ag

# Poll cadences (ms). Obligation enumeration is heavy → ~5 min.
KAMINO_POLL_MS=300000
JUPITER_LEND_POLL_MS=300000

# Helius Developer key — REQUIRED ONLY for C3 (anonymous HF-cascade
# getProgramAccountsV2 enumeration). C0-C2 (loop_exposure) run on free
# Kamino/Jupiter REST and do NOT need this.
# HELIUS_API_KEY=

# Error reporting (optional).
# SENTRY_DSN=
# SENTRY_RELEASE=
