{
  "name": "pegana-protocol-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "description": "Sub-C Loop Intelligence indexer — polls Kamino + Jupiter Lend for anonymous, aggregate leverage exposure and k-floored health-factor distributions (ADR-0036 variant A). Writes to the shared TimescaleDB; never reads or persists position owners.",
  "license": "MIT",
  "author": "Pegana <hello@pegana.xyz> (https://pegana.xyz)",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@jup-ag/lend-read": "^0.0.13",
