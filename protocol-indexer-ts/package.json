    "pg": "^8.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bn.js": "^5.2.0",
    "@types/bun": "latest",
    "@types/pg": "^8.11.0",
    "eslint": "^9",
    "globals": "^16",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "postcss": "^8.5.25"
  }
}
