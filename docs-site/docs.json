        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/PeganaHQ"
        }
      ]
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor"]
  },
  "seo": {
    "metatags": {
      "og:image": "/images/og.png",
