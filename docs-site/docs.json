{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Pegana",
  "description": "The peg-risk oracle for Solana. Real-time monitoring of LSTs, stablecoins, yield-bearing assets and synthetics. Read via REST, WebSocket and MCP. Free, with an open-source (MIT) oracle.",
  "colors": {
    "primary": "#ff8a5b",
    "light": "#fb6fae",
    "dark": "#df91f7"
  },
  "background": {
    "color": {
      "light": "#fafafa",
      "dark": "#0a0a0b"
    },
    "decoration": "gradient"
  },
  "favicon": "/images/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.pegana.xyz"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": "github-dark"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://www.pegana.xyz/dashboard"
    },
    "links": [
      { "label": "Status", "href": "https://www.pegana.xyz/status" },
      { "label": "Changelog", "href": "/changelog" }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/PeganaHQ",
      "x": "https://x.com/PeganaHQ"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Dashboard", "href": "https://www.pegana.xyz/dashboard" },
          { "label": "Embed widget", "href": "https://www.pegana.xyz/embed" },
          { "label": "Status", "href": "https://www.pegana.xyz/status" }
        ]
      },
      {
        "header": "Developers",
        "items": [
          { "label": "REST API", "href": "/guides/rest-api" },
          { "label": "WebSocket", "href": "/guides/websocket" },
          { "label": "MCP", "href": "/guides/mcp" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Pricing", "href": "/pricing" },
          { "label": "FAQ", "href": "/faq" },
          { "label": "GitHub", "href": "https://github.com/PeganaHQ" }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "Privacy", "href": "https://www.pegana.xyz/privacy" },
