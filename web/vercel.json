{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://docs.pegana.xyz",
      "permanent": true
    },
    {
      "source": "/docs/:match*",
      "destination": "https://docs.pegana.xyz/:match*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pegana.xyz" }],
      "destination": "https://www.pegana.xyz/:path*",
      "permanent": true
    }
  ]
}
