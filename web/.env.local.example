# Copy to .env.local and customize.
#
# Default points at the prod-local docker stack (port 8081).
# Boot it from repo root with:
#   docker compose -p pegana-prodlocal \
#     -f docker-compose.yml -f docker-compose.local.yml up -d
#
# If you'd rather run the Rust API natively for faster rebuilds, swap to
# :8080 and start `cargo run -p api-rs` from the repo root.
NEXT_PUBLIC_API_BASE=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8081/v1/ws

# Jupiter quote proxy (web/app/api/jupiter-quote). Optional locally; RECOMMENDED
# in production. Without a key the proxy falls back to the throttled/deprecating
# keyless lite-api.jup.ag, where /swap/v1/quote can hang. Provision a free key
# from https://developers.jup.ag on Vercel. The route accepts JUP_API_KEY OR
# JUPITER_API_KEY (the host indexer's var name) so a single name works everywhere.
# JUP_API_KEY=
